# ─── Supabase (public — safe to expose to the browser) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ─── what3words (SERVER ONLY — never prefix with NEXT_PUBLIC) ─────────────────
# Get a free developer key at https://developer.what3words.com
W3W_API_KEY=your-what3words-api-key

# ─── Feature flags / integration adapters ────────────────────────────────────
# Navigation provider: "google" (default, live) or "copilot" (stub)
NEXT_PUBLIC_NAV_PROVIDER=google
# Microlise journey/ePOD integration. Leave false until Waitrose grants creds.
MICROLISE_ENABLED=false

# ─── Optional: Google Maps key (only if we embed a map; not needed to launch
# the Google Maps app for navigation) ────────────────────────────────────────
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Optional: Upstash Redis for distributed rate limiting in production ──────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
