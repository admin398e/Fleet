# ─── Supabase (OPTIONAL) ─────────────────────────────────────────────────────
# Leave BOTH blank to run in DEMO MODE: a no-login /try page that needs only the
# what3words key (fastest way to test what3words + Google Maps today).
# Set BOTH to enable accounts + the shared address book.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── what3words (SERVER ONLY — never prefix with NEXT_PUBLIC) ─────────────────
# Get a free developer key at https://developer.what3words.com
W3W_API_KEY=your-what3words-api-key

# ─── Feature flags / integration adapters ────────────────────────────────────
# Navigation provider: "google" (default, live) or "copilot" (stub)
NEXT_PUBLIC_NAV_PROVIDER=google
# Microlise journey/ePOD integration. Leave false until Waitrose grants creds.
MICROLISE_ENABLED=false

# ─── Integration credentials (bring-your-own-key) ────────────────────────────
# Operators paste their own TruTac/TruLinks + Microlise keys in Settings →
# Integrations. Those secrets are encrypted at rest with this key before they
# reach the database. Generate one with:  openssl rand -base64 32
# Required only to SAVE credentials; demo mode boots fine without it.
INTEGRATION_ENCRYPTION_KEY=

# ─── Optional: Google Maps key (only if we embed a map; not needed to launch
# the Google Maps app for navigation) ────────────────────────────────────────
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Optional: Upstash Redis for distributed rate limiting in production ──────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
